<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reuses SMS's OWN import engine: the AgGateway ADAPT assemblies shipped with
    SMS (netstandard2.0, so they run on native .NET / Linux). This library only
    compiles against them; executables copy them (see Adapt.props).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AdaptCopyLocal>false</AdaptCopyLocal>
  </PropertyGroup>

  <Import Project="..\..\Adapt.props" />

  <ItemGroup>
    <ProjectReference Include="..\SmsLibre.Core\SmsLibre.Core.csproj" />
  </ItemGroup>

</Project>
