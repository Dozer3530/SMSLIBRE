<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmsLibre.App.MainWindow"
        Width="1280" Height="820"
        Title="SMSLIBRE"
        Background="#f3f3f3">

  <DockPanel>

    <!-- Menu bar (SMS-like top menu; most items are placeholders for parity) -->
    <Menu DockPanel.Dock="Top" Background="#e8e8e8">
      <MenuItem Header="_File">
        <MenuItem x:Name="OpenMenu" Header="_Open ISOXML dataset…" Click="OnOpen"/>
        <MenuItem x:Name="ExportMenu" Header="_Export map image…" Click="OnExportImage"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Yield classes">
          <MenuItem Header="5" Click="OnClasses" Tag="5"/>
          <MenuItem Header="7" Click="OnClasses" Tag="7"/>
          <MenuItem Header="9" Click="OnClasses" Tag="9"/>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About SMSLIBRE" Click="OnAbout"/>
      </MenuItem>
    </Menu>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="#e8e8e8" Padding="8,3">
      <TextBlock x:Name="StatusText" Text="Ready" FontSize="12"/>
    </Border>

    <!-- Body: tree | map | legend -->
    <Grid ColumnDefinitions="270,4,*,4,260">

      <!-- Left: navigation tree -->
      <Border Grid.Column="0" Background="White" BorderBrush="#ccc" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Management Tree" FontWeight="Bold"
                     Padding="8,6" Background="#f0f0f0"/>
          <TreeView x:Name="FieldTree" SelectionChanged="OnTreeSelectionChanged"
                    Padding="4">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Display}"/>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Background="#ddd"/>

      <!-- Center: map -->
      <Border Grid.Column="2" Background="#fbfbfb">
        <Grid>
          <Image x:Name="MapImage" Stretch="Uniform" Margin="6"/>
          <TextBlock x:Name="MapPlaceholder" Text="Select a yield dataset in the tree"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="#999" FontSize="16"/>
          <Border x:Name="StatsBox" Background="#ccffffff" BorderBrush="#bbb" BorderThickness="1"
                  CornerRadius="4" Padding="8" Margin="12"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="False">
            <TextBlock x:Name="StatsText" FontFamily="Consolas,monospace" FontSize="12"/>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Background="#ddd"/>

      <!-- Right: legend + title -->
      <Border Grid.Column="4" Background="White" BorderBrush="#ccc" BorderThickness="1,0,0,0">
        <DockPanel Margin="0">
          <TextBlock DockPanel.Dock="Top" Text="Legend" FontWeight="Bold"
                     Padding="8,6" Background="#f0f0f0"/>
          <TextBlock x:Name="LegendTitle" DockPanel.Dock="Top" Padding="8,6,8,2"
                     FontWeight="SemiBold" TextWrapping="Wrap"/>
          <ItemsControl x:Name="LegendItems" Margin="8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="20,*" Margin="0,2">
                  <Border Grid.Column="0" Width="16" Height="16" Background="{Binding Swatch}"
                          BorderBrush="#888" BorderThickness="1"/>
                  <TextBlock Grid.Column="1" Text="{Binding Text}" Margin="6,0,0,0"
                             FontSize="12" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
