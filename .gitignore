# SMSLIBRE — reverse engineering / porting workspace
#
# Nothing derived from the Ag Leader install is committed: it is large, it is
# regenerable from tools/, and it is not ours to redistribute. Only our own
# analysis notes, scripts, and port source live in git.

# Decompiler output (regenerate with tools/decompiler)
analysis/decompiled/

# Copies of the user's real agronomic data and the vendor's binaries
samples/

# Schema dumps can be large; the derived notes/ write-ups are what we keep
analysis/inventory/*.csv
analysis/schema/*.csv

# Brute-force log ends with the recovered DB password; keep it local only.
analysis/schema/*.log
# Throwaway render smoke-tests / intermediates
analysis/poc_viewer_smoketest.png
analysis/csharp_yieldmap.png
analysis/nh_yieldmap.png
analysis/chm/
# .NET / Visual Studio
.vs/
*.user
# Large extracted point data (regenerable via tools/adapt-proof extract)
analysis/*.geojson

# .NET build output
[Bb]in/
[Oo]bj/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
desktop.ini
# Generated GeoPackages (regenerable via smsimport)
analysis/*.gpkg
# Bundled .NET sidecar + packaged plugin (regenerate: python qgis_plugin/build_plugin.py)
qgis_plugin/smslibre_import/bin/
build/
analysis/scan_*.json
analysis/scan_*.log
analysis/*.json
analysis/*.log
# John Deere SDK credentials — licensed materials, never commit
**/johndeere.adaptplugins.lic
**/johndeere.appid
**/ApplicationId.txt
# Vendor SDK packages (licensed materials - never commit)
vendor/

# Vault sweep working files: multi-GB GeoPackages written and deleted per card,
# plus the raw scan output. The report and results.json are committed by hand.
analysis/vault*/*.gpkg
analysis/vault*/scan.json
analysis/vault*/run.log
analysis/vault*/scan.log
